#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
should_run=0
target_sha=""

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$remote_ref" == "refs/heads/main" && "$local_sha" != "0000000000000000000000000000000000000000" ]]; then
    should_run=1
    target_sha="$local_sha"
  fi
done

if [[ "$should_run" != "1" ]]; then
  exit 0
fi

python_bin="${PYTHON:-}"
if [[ -z "$python_bin" ]]; then
  if [[ -x "$repo_root/.venv-dev/bin/python" ]]; then
    python_bin="$repo_root/.venv-dev/bin/python"
  else
    python_bin="python3"
  fi
fi

exec "$python_bin" \
  "$repo_root/scripts/benchmark/run_devils_eye_xl_benchmark.py" \
  --label "main-push-${target_sha:0:12}"
