  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name>CaveViewer</name>
  <summary>Explore very large 3D cave-survey maps</summary>
  <description>
    <p>
      CaveViewer is an interactive viewer for very large OBJ and GLB cave
      surveys. It builds a spatial cache and streams map chunks so scans can
      be explored on systems with a wide range of memory and graphics hardware.
    </p>
    <p>
      Navigate the survey in 3D, inspect a minimap,
      save viewpoints, adjust rendering, and record the viewer when needed.
    </p>
  </description>
  <launchable type="desktop-id">io.github.caveviewer.caveviewer.desktop</launchable>
  <provides>
    <mediatype>model/gltf-binary</mediatype>
    <mediatype>model/obj</mediatype>
  </provides>
